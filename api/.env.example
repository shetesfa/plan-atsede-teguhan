# ============================================================
# የአጸደ ትጉሃን አገልጋይ ውቅር (Environment Configuration)
# ማሳሰቢያ፦ ይህ ፋይል ሚስጥራዊ በመሆኑ በጊት (Git) ውስጥ አይካተትም!
# ============================================================

# የዳታቤዝ ውቅር
DB_HOST=localhost
DB_NAME=atsede_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# የስርዓቱ የሰዓት ቀጣና
TIMEZONE=Africa/Addis_Ababa

# የደህንነት ቶከን ምስጢር ቁልፍ (JWT / App Secret)
JWT_SECRET=atsede_teguhan_secure_key_2019_addis_ababa_ethiopia_orthodox

# የቴሌግራም ቦት ውቅር (የቦት ቶከን እዚህ ብቻ ነው የሚቀመጠው)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# የፋይል ሰቀላ ገደብ (ባይት)
MAX_UPLOAD_SIZE=20971520 # 20MB
