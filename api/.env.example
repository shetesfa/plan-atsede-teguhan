# ============================================================
# የአጸደ ትጉሃን አገልጋይ ውቅር አብነት (Environment Configuration Example)
# ይህ ፋይል በ Git ውስጥ የሚቀመጥ አብነት ብቻ ነው።
# ትክክለኛ ምስክርነቶችን በጭራሽ እዚህ አያስገቡ!
# ============================================================

# የስርዓት ሁኔታ (development or production)
APP_ENV=production

# የዳታቤዝ ውቅር
DB_HOST=127.0.0.1
DB_NAME=atsede_db
DB_USER=your_db_user_here
DB_PASS=your_secure_db_password_here
DB_CHARSET=utf8mb4

# የስርዓቱ የሰዓት ቀጣና (በኢትዮጵያ ሰዓት አቆጣጠር)
TIMEZONE=Africa/Addis_Ababa

# የደህንነት ቶከን ምስጢር ቁልፍ (ቢያንስ 32 ፊደላት/ቁጥሮች ያለው ጠንካራ ሚስጥር መሆን አለበት)
# ምሳሌ ማመንጫ፦ openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars

# የተፈቀዱ የ CORS አመጣጦች (በነጠላ ሰረዝ የተከፋፈሉ)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:8000,http://localhost:8080

# የቴሌግራም ቦት ውቅር (የቦት ቶከን እዚህ ብቻ ነው የሚቀመጠው)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# የፋይል ሰቀላ ገደብ (ባይት - ነባሪ 20MB)
MAX_UPLOAD_SIZE=20971520
